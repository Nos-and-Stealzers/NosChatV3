DATABASE_URL=postgres://noschat:noschat@localhost:5433/noschat
REDIS_URL=redis://localhost:6379

# NOTE: Postgres is mapped to host port 5433, not the default 5432 — this dev
# machine already has a native Windows PostgreSQL service using 5432. See
# docker-compose.yml for details.

# Clerk — this service verifies Clerk-issued session JWTs and syncs users
# via webhook. Get real values from the Clerk dashboard for this project.
# JWKS URL: Clerk dashboard -> API Keys -> Show JWKS URL (or
# https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json).
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Webhook signing secret: Clerk dashboard -> Webhooks -> your endpoint ->
# Signing Secret. NOT the same as the frontend's CLERK_SECRET_KEY.
CLERK_WEBHOOK_SECRET=whsec_changeme
