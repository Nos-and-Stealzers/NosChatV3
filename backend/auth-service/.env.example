DATABASE_URL=postgres://noschat:***@localhost:5433/noschat

# Currently unused by this service (no Redis-backed features implemented
# yet — WS hub state lives in-process in ws.rs). Left here so the compose
# files / homelab stack stay consistent and this can be wired in later
# (e.g. cross-instance pub/sub for WS fanout) without a config-shape change.
REDIS_URL=redis://localhost:6379

# NOTE: Postgres is mapped to host port 5433, not the default 5432 — this dev
# machine already has a native Windows PostgreSQL service using 5432. See
# docker-compose.yml for details. (Not relevant for docker-compose.prod.yml,
# where the backend talks to Postgres over the internal Docker network on
# its default port.)

# Clerk — this service verifies Clerk-issued session JWTs and syncs users
# via webhook. Get real values from the Clerk dashboard for this project.
# JWKS URL: Clerk dashboard -> API Keys -> Show JWKS URL (or
# https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json).
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Webhook signing secret: Clerk dashboard -> Webhooks -> your endpoint ->
# Signing Secret. NOT the same as the frontend's CLERK_SECRET_KEY.
#
# If you leave this unset or at the placeholder value below, the service
# still runs and sign-in/sign-up still work end-to-end — GET /me lazily
# creates the local `users` row from the verified JWT the first time it's
# needed (see routes.rs::get_or_create_local_user). You'll just miss
# webhook-driven updates/deletes until this is set. Startup logs print a
# full walkthrough (dashboard steps + `clerk webhooks listen` CLI
# alternative) whenever this is left unconfigured.
CLERK_WEBHOOK_SECRET=whsec_changeme
