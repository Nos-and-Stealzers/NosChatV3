# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it's already in .gitignore.

# --- Clerk (auth) ---------------------------------------------------------
# Clerk dashboard -> your app -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_changeme
CLERK_SECRET_KEY=sk_test_changeme

# Canonical auth routes in this app are /sign-in and /sign-up (Clerk's own
# default routing convention — see src/app/(auth)/sign-in and sign-up).
# These two env vars tell Clerk's components where to send an
# unauthenticated user; they must match the routes that actually exist.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Backend (Rust auth-service) -----------------------------------------
# Local dev default matches backend/auth-service's default bind address
# (0.0.0.0:4000). In production, point these at your homelab's public
# domain (behind Caddy/HTTPS) or wherever the backend is actually reachable.
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_SERVICE_WS_URL=ws://localhost:4000/ws
