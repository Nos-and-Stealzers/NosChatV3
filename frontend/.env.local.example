# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it's already in .gitignore.

# --- Clerk (auth) ---------------------------------------------------------
# Clerk dashboard -> your app -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_changeme
CLERK_SECRET_KEY=«redacted:sk_test_…»

# Canonical auth routes in this app are /sign-in and /sign-up (Clerk's own
# default routing convention — see src/app/(auth)/sign-in and sign-up).
# These two env vars tell Clerk's components where to send an
# unauthenticated user; they must match the routes that actually exist.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Production domain for this app: https://noschatv2.noslab.fun — this MUST
# also be added to the Clerk instance's `allowed_origins` (Clerk dashboard ->
# your app -> Configure -> API Keys/Domains, or via a PATCH to
# https://api.clerk.com/v1/instance with your CLERK_SECRET_KEY) or sign-in
# will fail with a cross-origin error once deployed there. This has already
# been done for the current Clerk instance as of this commit — re-do it if
# you ever rotate to a different Clerk application.

# --- Backend (Rust auth-service) -----------------------------------------
# Local dev default matches backend/auth-service's default bind address
# (0.0.0.0:4000). In production, point these at your homelab's public
# domain (behind Caddy/HTTPS) or wherever the backend is actually reachable.
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_SERVICE_WS_URL=ws://localhost:4000/ws

# --- WebRTC calling (voice/video/screen share) ----------------------------
# Optional. JSON array of RTCIceServer objects. Leave unset for local dev —
# defaults to a free public STUN server (fine for most calls). Only needed
# once you're self-hosting a TURN server (coturn) for reliable calling
# across strict corporate/CGNAT networks — see HOSTING.txt Section 7.
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
